---
// Line icons set inside a diamond frame. Drawn on a 48×48 grid.
interface Props {
  name: 'landscapes' | 'lore' | 'characters' | 'flux';
}

const { name } = Astro.props;
---

<span class="feature-icon" aria-hidden="true">
  <svg viewBox="0 0 80 80">
    <path class="feature-icon__frame" d="M40 3 L77 40 L40 77 L3 40 Z" />
    <path class="feature-icon__frame feature-icon__frame--inner" d="M40 10 L70 40 L40 70 L10 40 Z" />
    <g transform="translate(16 16)" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
      {name === 'landscapes' && (
        <>
          <path d="M8 34 L19 16 L25 25 L30 18 L40 34 Z" />
          <path d="M16 21 L19 16 L22 21 L19 23 Z" fill="currentColor" />
          <path d="M28 21 L30 18 L32 21" />
          <path d="M12 38 h24" opacity="0.6" />
        </>
      )}
      {name === 'lore' && (
        <>
          <path d="M24 14 L24 36" />
          <path d="M24 14 C19 11 13 11 9 13 L9 34 C13 32 19 32 24 36 C29 32 35 32 39 34 L39 13 C35 11 29 11 24 14 Z" />
          <path d="M13 19 h6 M13 24 h6 M29 19 h6 M29 24 h6" opacity="0.7" />
        </>
      )}
      {name === 'characters' && (
        <>
          <circle cx="24" cy="16" r="6.5" />
          <path d="M11 38 C11 30.5 16.5 26 24 26 C31.5 26 37 30.5 37 38" />
        </>
      )}
      {name === 'flux' && (
        <>
          <circle cx="24" cy="24" r="13" />
          <circle cx="24" cy="24" r="4" fill="currentColor" />
          <path d="M24 7 L24 15 M24 33 L24 41 M7 24 L15 24 M33 24 L41 24" />
          <path d="M14 14 L18 18 M30 30 L34 34 M34 14 L30 18 M18 30 L14 34" opacity="0.7" />
        </>
      )}
    </g>
  </svg>
</span>
