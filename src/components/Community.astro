---
import SocialLinks from './SocialLinks.astro';
---

<section class="frame community" id="community" aria-labelledby="community-title">
  <div class="frame__inner">
    <img class="community__art" src="/images/character.webp" alt="" loading="lazy" width="460" height="450" />
    <img class="community__mark" src="/images/logo.webp" alt="" width="52" height="52" />
    <div class="community__copy">
      <h2 id="community-title">Join our community</h2>
      <p>Be part of a growing community of adventurers, artists, and lore enthusiasts.</p>
      <SocialLinks />
    </div>
  </div>
</section>
