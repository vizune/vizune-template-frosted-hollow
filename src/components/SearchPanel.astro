---
import { gallery, news, sections, site } from '../data/site';

// Everything the search can find. Swap this for Pagefind (pagefind.app)
// once the site has real pages.
const index = [
  ...news.map((n) => ({ type: n.category, title: n.title, text: n.excerpt, href: n.href, image: n.image })),
  ...gallery.map((g, i) => ({ type: 'Artwork', title: g.title, text: g.alt, href: '#gallery', image: g.src, slide: i })),
  ...sections.map((s) => ({ type: 'Pages', title: s.title, text: s.text, href: s.href, action: s.action })),
];
---

<div class="search" id="site-search" data-search data-index={JSON.stringify(index)}>
  <div class="search__inner">
    <form class="search__form" role="search" data-search-form>
      <svg class="search__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      <label class="sr-only" for="search-input">{`Search ${site.name}`}</label>
      <input
        id="search-input"
        type="search"
        placeholder="Search the realm…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <button type="button" class="search__esc" data-search-close aria-label="Close search">Esc</button>
    </form>

    <div class="search__body">
      <div class="search__suggest" data-search-suggest>
        <p class="search__label">Quick links</p>
        <ul class="search__chips">
          {sections.map((s) => (
            <li>
              <a href={s.href} data-action={s.action}>
                <span class="search__chip-mark" aria-hidden="true"></span>
                {s.quick}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="search__results" id="search-results" role="listbox" aria-label="Search results" data-search-results></div>

      <p class="search__empty" data-search-empty hidden>
        No echoes found for “<span data-search-term></span>”. Try another word.
      </p>

      <p class="search__hint" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
        <span><kbd>Enter</kbd> to open</span>
        <span><kbd>Esc</kbd> to close</span>
      </p>
    </div>
  </div>
</div>
