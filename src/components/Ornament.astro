---
// A centred diamond with tapering rules either side.
interface Props {
  variant?: 'divider' | 'small';
}

const { variant = 'divider' } = Astro.props;
---

<div class={`ornament ornament--${variant}`} aria-hidden="true">
  <span class="ornament__line"></span>
  <svg viewBox="0 0 40 40" width="28" height="28">
    <path d="M20 2 L38 20 L20 38 L2 20 Z" fill="none" stroke="currentColor" stroke-width="1.2" />
    <path d="M20 9 L31 20 L20 31 L9 20 Z" fill="none" stroke="currentColor" stroke-width="1" opacity="0.7" />
    <path d="M20 15 L25 20 L20 25 L15 20 Z" fill="currentColor" />
  </svg>
  <span class="ornament__line"></span>
</div>
