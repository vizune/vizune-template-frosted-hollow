---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ornament from '../components/Ornament.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsCard from '../components/NewsCard.astro';
import WorldSection from '../components/WorldSection.astro';
import Gallery from '../components/Gallery.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import TrailerModal from '../components/TrailerModal.astro';
import { news } from '../data/site';
---

<Layout>
  <div class="page">
    <Header />
    <main>
      <Hero />
      <Ornament />

      <section class="section" aria-labelledby="news">
        <SectionHeading id="news" title="Latest from Frosthollow" linkLabel="View all news" href="#" />
        <div class="news-grid">
          {news.map((item) => <NewsCard {...item} />)}
        </div>
      </section>

      <section class="section showcase">
        <WorldSection />
        <div class="showcase__side">
          <Gallery />
          <Community />
        </div>
      </section>
    </main>
    <Footer />
  </div>
  <TrailerModal />
</Layout>
